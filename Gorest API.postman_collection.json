          "name": "getting user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();\n\n//Status code validation\npm.test(\"Successfull POST request\", ()=> {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Status code has string\", ()=> {pm.response.to.have.status(200)});\n\n//Response body validation\npm.test (\"Response body values\", ()=> {\n    pm.expect (jsonData.id).to.eql(pm.collectionVariables.get(\"userid_env\")); \n    pm.expect (jsonData.name).to.eql(pm.collectionVariables.get(\"name\"));\n    pm.expect (jsonData.email).to.eql(pm.collectionVariables.get(\"email\"));\n    pm.expect(jsonData.gender).to.eql(\"male\");\n    pm.expect(jsonData.status).to.eql(\"inactive\");\n});"
                ]
              }
            }
          ],
